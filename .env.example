# PostgreSQL
DATABASE_URL=postgresql+psycopg://web_llm:web_llm@localhost:5432/web_llm
DB_USER=web_llm
DB_PASSWORD=web_llm
DB_NAME=web_llm

# API
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL container port (host side)
POSTGRES_PORT=5432

# Keycloak (подключение backend'а; при запуске в docker-compose переопределяется на http://keycloak:8080)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=web-llm
KEYCLOAK_CLIENT_ID=web-llm-backend
KEYCLOAK_CLIENT_SECRET=web-llm-backend-secret
KEYCLOAK_DEFAULT_ROLE=user

# Публичный адрес Keycloak, доступный браузеру (редирект на страницу входа Google)
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Адрес фронтенда: callback входа через Google редиректит браузер сюда с токенами
FRONTEND_URL=http://localhost:5173
# Эндпоинт backend'а для возврата браузера после входа через Google
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/user/login/google/callback
# Alias identity provider'а Google в Keycloak
GOOGLE_IDP_ALIAS=google

# Клиент id и секрет для google oauth
GOOGLE_CLIENT_ID=client_id
GOOGLE_CLIENT_SECRET=secret

# Keycloak контейнеры (docker-compose)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak


# PostgreSQL
DATABASE_URL=postgresql+psycopg://web_llm:web_llm@localhost:5432/web_llm
DB_USER=web_llm
DB_PASSWORD=web_llm
DB_NAME=web_llm

# API
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL container port (host side)
POSTGRES_PORT=5432

# Keycloak (подключение backend'а; при запуске в docker-compose переопределяется на http://keycloak:8080)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=web-llm
KEYCLOAK_CLIENT_ID=web-llm-backend
# Секрет клиента web-llm-backend: обязателен (дефолта нет). Подставляется в realm
# при импорте (плейсхолдер ${KEYCLOAK_CLIENT_SECRET} в keycloak/realm-web-llm.json),
# поэтому значение должно совпадать для контейнеров keycloak и app
KEYCLOAK_CLIENT_SECRET=web-llm-backend-secret

# Публичный адрес Keycloak, доступный браузеру (редирект на страницу входа)
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Адрес фронтенда: callback входа редиректит браузер сюда после создания сессии.
# 8090 — фронтенд в Docker, 5173 — dev-сервер Vite
FRONTEND_URL=http://localhost:8090
# Единый callback backend'а для входа (форма Keycloak и Google);
# должен быть в Valid Redirect URIs клиента web-llm-backend в realm
KEYCLOAK_REDIRECT_URI=http://localhost:8000/api/v1/user/login/callback
# Alias identity provider'а Google в Keycloak
GOOGLE_IDP_ALIAS=google

# Client ID и Client Secret из Google Cloud Console (OAuth client типа Web application).
# Подставляются в realm при импорте (плейсхолдеры ${GOOGLE_CLIENT_ID}/${GOOGLE_CLIENT_SECRET}
# в keycloak/realm-web-llm.json); Authorized redirect URI в Google:
# http://localhost:8080/realms/web-llm/broker/google/endpoint
GOOGLE_CLIENT_ID=client_id
GOOGLE_CLIENT_SECRET=secret

# Keycloak контейнеры (docker-compose)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak

# Embedding-сервис (llama.cpp, Qwen3-Embedding)
# Хостовый порт: llama-server слушает внутри контейнера на 8080, наружу — только с localhost
EMBEDDING_PORT=8081
# Адрес для backend'а вне docker-compose (локальный запуск uvicorn);
# при запуске app в docker-compose переопределяется на http://embeddings:8080
EMBEDDING_URL=http://localhost:8081

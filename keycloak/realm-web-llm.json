{
  "realm": "web-llm",
  "displayName": "Web LLM",
  "enabled": true,
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Пользователь чата: базовый доступ к приложению, без подписки чат запрещён"
      },
      {
        "name": "vip_user",
        "description": "Пользователь с подпиской: доступ к чату"
      },
      {
        "name": "admin",
        "description": "Администратор системы"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-web-llm",
    "description": "Роли по умолчанию: user получают все новые пользователи, в т.ч. созданные брокером Google (он проходит мимо backend'а)",
    "composite": true,
    "clientRole": false,
    "composites": {
      "realm": ["user"]
    }
  },
  "clients": [
    {
      "clientId": "web-llm-backend",
      "name": "Web LLM Backend",
      "description": "Серверная часть: вход по паролю (direct access grants), вход через Google (standard flow: браузер уходит в Keycloak и возвращается с кодом на callback backend'а) и управление пользователями (service account).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "web-llm-backend-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:8000/api/v1/user/login/google/callback"
      ],
      "webOrigins": ["+"],
      "defaultClientScopes": ["web-origins", "profile", "email", "roles", "basic"],
      "optionalClientScopes": ["kc-admin-api"]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "config": {
        "clientId": "ЗАПОЛНИТЬ: Client ID из Google Cloud Console",
        "clientSecret": "ЗАПОЛНИТЬ: Client Secret из Google Cloud Console",
        "useJwksUrl": "true"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-web-llm-backend",
      "enabled": true,
      "serviceAccountClientId": "web-llm-backend",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "view-realm"]
      }
    }
  ]
}
